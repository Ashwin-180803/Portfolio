---
import type { Project } from "../data/projects";
import { withBase } from "../lib/paths";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a
  href={withBase(`/projects/${project.slug}`)}
  class="group pipeline-glow block rounded-sm border border-line bg-surface p-6 transition hover:border-teal/50"
>
  <p class="font-mono text-xs uppercase tracking-widest text-teal">{project.layer}</p>
  <h3 class="mt-3 text-xl font-semibold text-paper group-hover:text-teal">{project.title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-mist">{project.summary}</p>
  <ul class="mt-5 flex flex-wrap gap-2">
    {
      project.stack.slice(0, 4).map((item) => (
        <li class="rounded-sm border border-line px-2 py-0.5 font-mono text-[11px] text-mist">{item}</li>
      ))
    }
  </ul>
</a>
