---
import { profile } from "../data/profile";
import { withBase } from "../lib/paths";
---

<section class="relative overflow-hidden border-b border-line">
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-40"></div>
  <div class="relative mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-teal">
      {profile.location} · available for data engineering roles
    </p>
    <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight text-paper sm:text-6xl">
      {profile.name}
    </h1>
    <p class="mt-3 font-mono text-lg text-teal sm:text-xl">{profile.title}</p>
    <p class="mt-6 max-w-2xl text-lg text-mist sm:text-xl">
      {profile.headline} Four local-first projects walk a Citi Bike dataset from raw CSV to tested warehouse tables.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={withBase("/projects")}
        class="rounded-sm bg-teal px-5 py-2.5 text-sm font-medium text-ink transition hover:bg-paper"
      >
        View projects
      </a>
      <a
        href={profile.github}
        class="rounded-sm border border-line px-5 py-2.5 text-sm text-paper transition hover:border-teal hover:text-teal"
        target="_blank"
        rel="noreferrer"
      >
        GitHub
      </a>
    </div>
  </div>
</section>
