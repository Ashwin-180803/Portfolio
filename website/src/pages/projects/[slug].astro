---
import Layout from "../../layouts/Layout.astro";
import { profile } from "../../data/profile";
import { projects, getProject } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug ?? "");

if (!project) {
  throw new Error(`Unknown project: ${slug}`);
}

const githubProject = `${profile.github}/Portfolio/tree/main/${project.repoPath}`;
---

<Layout title={`${project.title} · ${profile.name}`} description={project.summary}>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-widest text-teal">{project.layer}</p>
    <h1 class="mt-3 text-4xl font-semibold">{project.title}</h1>
    <p class="mt-4 text-lg text-mist">{project.summary}</p>

    <dl class="mt-8 grid grid-cols-3 gap-3 border border-line bg-surface p-4">
      {
        project.metrics.map((metric) => (
          <div>
            <dt class="font-mono text-[11px] uppercase tracking-widest text-mist">{metric.label}</dt>
            <dd class="mt-1 font-mono text-lg text-teal">{metric.value}</dd>
          </div>
        ))
      }
    </dl>

    <section class="mt-12">
      <h2 class="text-xl font-semibold">Problem</h2>
      <p class="mt-3 leading-relaxed text-mist">{project.problem}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">Architecture</h2>
      <p class="mt-3 rounded-sm border border-line bg-ink-2 p-4 font-mono text-sm leading-relaxed text-paper">
        {project.architecture}
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">What I built</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-mist">
        {project.whatIBuilt.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">Stack</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          project.stack.map((item) => (
            <li class="rounded-sm border border-line px-2.5 py-1 font-mono text-xs text-paper">{item}</li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">How to run</h2>
      <pre class="mt-3 overflow-x-auto rounded-sm border border-line bg-ink-2 p-4 font-mono text-sm text-teal"><code>{project.run.join("\n")}</code></pre>
    </section>

    <section class="mt-10 rounded-sm border border-teal/30 bg-surface p-5">
      <h2 class="font-mono text-xs uppercase tracking-widest text-teal">What a recruiter should notice</h2>
      <p class="mt-3 text-mist">{project.recruiterTakeaway}</p>
    </section>

    <p class="mt-10 font-mono text-sm">
      <a class="text-teal hover:underline" href={githubProject} target="_blank" rel="noreferrer">
        Source on GitHub →
      </a>
    </p>
  </article>
</Layout>
