---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { profile } from "../../data/profile";
import { projects } from "../../data/projects";
---

<Layout title={`Projects · ${profile.name}`} description="Data engineering case studies: lakehouse, dbt, orchestration, and quality.">
  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-widest text-teal">Case studies</p>
    <h1 class="mt-2 text-3xl font-semibold sm:text-4xl">Projects</h1>
    <p class="mt-4 max-w-2xl text-mist">
      Four pieces of one platform. Each folder is a standalone repo with a README, sample data, and a command that actually runs.
    </p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Layout>
